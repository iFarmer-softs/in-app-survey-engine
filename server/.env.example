# Server Port
PORT=3000

# PostgreSQL Configuration
# You can use DATABASE_URL or individual DB_* variables
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/survey_engine

# Or discrete parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=survey_engine
DB_SSL=false

# Auto Synchronize schema with database in development (true/false)
DB_SYNCHRONIZE=true

